{
  "name": "dpia",
  "version": "0.2.0",
  "private": true,
  "description": "Estudio local de fotografía, tamaños de impresión y mejora opcional con IA",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs debug",
    "android:release": "npm run android:sync && node scripts/android-build.mjs release",
    "android:open": "cap open android",
    "licenses": "node scripts/notices.mjs",
    "predev": "node scripts/verify-bundled-model.mjs && node scripts/runtime.mjs",
    "prebuild": "node scripts/verify-bundled-model.mjs && node scripts/runtime.mjs && node scripts/package-notices.mjs",
    "pretest:e2e": "node scripts/test-model.mjs",
    "desktop:exe": "tauri build --no-bundle"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@jsquash/avif": "^2.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "jspdf": "^3.0.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
